generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A customer of the platform, e.g. an NBFC. All programs and applicants belong to one.
model Organization {
  id        String          @id @default(cuid())
  name      String
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  users     AdminUser[]
  programs  Program[]
  bureaus   BureauSetting[]
  bureauCredentials BureauCredential[]
}

model AdminUser {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String
  passwordHash   String
  role           String        @default("ADMIN") // SUPERADMIN | ADMIN
  organizationId String? // null for superadmins
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  active         Boolean       @default(true)
  // Bumped on password reset or disable, which signs the user out everywhere.
  sessionVersion Int           @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime      @default(now())
}

// Which bureaus a superadmin has enabled for an organization. Credentials live in env vars, never in the DB.
model BureauSetting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bureau         String // EQUIFAX | CIBIL | CRIF | EXPERIAN
  enabled        Boolean      @default(false) // set by superadmin
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, bureau])
}

// An organization's own API access to a bureau (its membership). Secrets are AES-256-GCM encrypted.
model BureauCredential {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bureau         String
  endpointUrl    String
  encrypted      String // encrypted JSON of the bureau's credential fields
  hint           String       @default("") // non-secret label shown in the UI, e.g. masked member number
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, bureau])
}

// A rule engine. Each program has its own criteria, bureau and shareable link.
model Program {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug          String   @unique
  category      String // e.g. Education, Consumer Brands
  description   String   @default("")
  bureau        String   @default("EQUIFAX")
  inquiryPurpose String  @default("05") // bureau enquiry purpose code, e.g. 05 = Personal Loan
  minScore      Int      @default(650)
  maxDtiPct     Int      @default(40)
  maxDefaults   Int      @default(0)
  minAge        Int      @default(21)
  maxAge        Int      @default(60)
  approvedLimit Int      @default(50000)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  checks        EligibilityCheck[]

  @@index([organizationId])
}

model EligibilityCheck {
  id            String   @id @default(cuid())
  programId     String
  program       Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  name          String
  mobile        String
  panMasked     String // e.g. XXXXX1234F; full PAN is never stored
  panHash       String // SHA-256, lets admins spot repeat checks
  age           Int
  bureau        String
  score         Int?
  dtiPct        Int?
  defaults      Int?
  monthlyIncome Int?
  existingEmi   Int? // monthly EMIs from the bureau report
  bureauRef     String? // bureau's report reference, for audit
  status        String // APPROVED | DECLINED | ERROR
  reasons       String   @default("[]") // JSON array of strings
  approvedLimit Int      @default(0)
  latencyMs     Int      @default(0)
  source        String   @default("LINK") // LINK | BULK
  createdAt     DateTime @default(now())

  @@index([programId, createdAt])
  @@index([status])
}
