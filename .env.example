# Copy to .env and fill in.
DATABASE_URL="file:./dev.db"

# Long random string used to sign admin session cookies.
SESSION_SECRET="replace-with-a-long-random-string"

# Platform owner account, created by `npm run db:seed`. Manages organizations and their admins.
# The sign-in ID can be an email or a plain username.
SUPERADMIN_EMAIL="superadmin@example.com"
SUPERADMIN_PASSWORD="change-me-too"

# Optional: a demo organization with this admin and sample programs. Remove to skip.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Live bureau credentials. Leave blank to use MOCK mode only.
EQUIFAX_API_URL=""
EQUIFAX_API_KEY=""
CIBIL_API_URL=""
CIBIL_API_KEY=""
CRIF_API_URL=""
CRIF_API_KEY=""
EXPERIAN_API_URL=""
EXPERIAN_API_KEY=""
