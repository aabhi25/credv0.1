# Copy to .env and fill in.
DATABASE_URL="file:./dev.db"

# Long random string used to sign admin session cookies.
SESSION_SECRET="replace-with-a-long-random-string"

# First admin account, created by `npm run db:seed`.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Live bureau credentials. Leave blank to use MOCK mode only.
EQUIFAX_API_URL=""
EQUIFAX_API_KEY=""
CIBIL_API_URL=""
CIBIL_API_KEY=""
CRIF_API_URL=""
CRIF_API_KEY=""
EXPERIAN_API_URL=""
EXPERIAN_API_KEY=""
